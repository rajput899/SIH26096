{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/archive/[...path]",
      "regex": "^/api/archive/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPpath": "nxtPpath"
      },
      "namedRegex": "^/api/archive/(?<nxtPpath>.+?)(?:/)?$"
    },
    {
      "page": "/archive/[id]",
      "regex": "^/archive/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/archive/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/certificate/[id]",
      "regex": "^/certificate/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/certificate/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/experience/[topic]",
      "regex": "^/experience/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtopic": "nxtPtopic"
      },
      "namedRegex": "^/experience/(?<nxtPtopic>[^/]+?)(?:/)?$"
    },
    {
      "page": "/quiz/[id]",
      "regex": "^/quiz/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/quiz/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/ai",
      "regex": "^/ai(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ai(?:/)?$"
    },
    {
      "page": "/api/health",
      "regex": "^/api/health(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/health(?:/)?$"
    },
    {
      "page": "/archive",
      "regex": "^/archive(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/archive(?:/)?$"
    },
    {
      "page": "/experience",
      "regex": "^/experience(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/experience(?:/)?$"
    },
    {
      "page": "/leaderboard",
      "regex": "^/leaderboard(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/leaderboard(?:/)?$"
    },
    {
      "page": "/speeches",
      "regex": "^/speeches(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/speeches(?:/)?$"
    },
    {
      "page": "/staff",
      "regex": "^/staff(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/staff(?:/)?$"
    },
    {
      "page": "/system",
      "regex": "^/system(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/system(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}