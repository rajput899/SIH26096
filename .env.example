# Run python scripts/init_env.py to create .env with a random local password.
POSTGRES_DB=sih26096
POSTGRES_USER=sih_app
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
QDRANT_URL=http://qdrant:6333
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
# Deliberately unset: Phase 0 does not download or require a model.
OLLAMA_GENERATION_MODEL=
OLLAMA_EMBEDDING_MODEL=
HEALTH_TIMEOUT_SECONDS=3
BACKEND_INTERNAL_URL=http://backend:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Phase 3 optional settings; model names above remain explicitly configurable.
RESEARCH_COLLECTION=verified_archive_v1
GENERATION_TIMEOUT_SECONDS=45



# Generation provider only. Gemini secrets are backend-only. No automatic fallback.
AI_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional opt-in certificate email. Backend only; STARTTLS required.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
CERTIFICATE_PUBLIC_URL=http://localhost:3000

# Backend-only Bhashini translation. Existing Udyat_Key / Inference aliases work.
# Never put these values in NEXT_PUBLIC_* variables. See BHASHINI_VALIDATION.md.
BHASHINI_UDYAT_KEY=
BHASHINI_INFERENCE_KEY=
# Optional pipeline discovery requires both details from your Bhashini account.
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
BHASHINI_TRANSLATION_SERVICE_ID=bhashini/iiith/nmt-all
TRANSLATION_TIMEOUT_SECONDS=20
